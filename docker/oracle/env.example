# Copy to .env.oracle on the Oracle VM; never copy your local .env.
# Blank values must be set before compose can start.
ORACLE_DOMAIN=
ACME_EMAIL=
APP_KEY=
ORACLE_DB_PASSWORD=
ORACLE_DB_ROOT_PASSWORD=
# Use a release's full Git SHA and retain the prior images for rollback.
ORACLE_RELEASE=trial
BACKUP_RETENTION_DAYS=14
# Public trial uses the defaults below. Never publish internal service ports.
ORACLE_BIND_IP=0.0.0.0
ORACLE_HTTP_PORT=80
ORACLE_HTTPS_PORT=443
